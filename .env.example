# Module A doesn't need any secret keys yet — the LinkedIn connection is
# currently faked (see electron/ipc/linkedin.ipc.ts), so there's no real
# API key to configure.
#
# Once Person 3 builds the real LinkedIn OAuth flow, real credentials will
# need to go here, most likely something like:
#
# LINKEDIN_CLIENT_ID=your-linkedin-app-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-app-client-secret
#
# (Get these from LinkedIn's developer portal after registering an app —
# see SOW Section 6: this requires LinkedIn's official Marketing
# Developer Platform approval, which has its own lead time.)
