# Module B doesn't need any secret keys yet — every data source (keyword
# volume/difficulty, site audits, competitor gaps, Google Business
# Profile) is currently faked in electron/ipc/seo.ipc.ts, so there's
# nothing real to authenticate with.
#
# Once the real backend integrations are built, keys will likely be
# needed here for:
#
# SEO_DATA_API_KEY=...              # DataForSEO / SEMrush / Ahrefs (pick one) — see modules/seo/services/keywordProvider.ts
# GOOGLE_PAGESPEED_API_KEY=...      # Google PageSpeed Insights API — see modules/seo/services/technicalChecks.ts
# GOOGLE_SEARCH_CONSOLE_CLIENT_ID=...
# GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=...
# GOOGLE_BUSINESS_PROFILE_CLIENT_ID=...     # see modules/seo/services/gbpApi.ts
# GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=...
#
# (Per SOW Section 10: a paid SEO data API subscription needs to be
# procured before this phase begins — that's a purchasing decision, not
# an engineering one.)
