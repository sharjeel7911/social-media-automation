{
  "name": "social-media-automation-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Social Media Marketing Automation Platform - Monorepo",
  "workspaces": [
    "apps/*",
    "backend/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace=apps/electron-desktop run dev",
    "build:desktop": "npm --workspace=apps/electron-desktop run build",
    "start:backend:posts": "npm --workspace=backend/module-a-posts run start:dev",
    "start:backend:seo": "npm --workspace=backend/module-b-seo run start:dev",
    "start:backend:leads": "npm --workspace=backend/module-c-leads run start:dev",
    "start:backend:analytics": "npm --workspace=backend/module-d-analytics run start:dev"
  },
  "keywords": [
    "electron",
    "react",
    "nestjs",
    "automation",
    "marketing"
  ],
  "author": "",
  "license": "ISC"
}